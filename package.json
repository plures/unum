{
  "name": "@plures/unum",
  "version": "0.3.0",
  "description": "Reactive Svelte bindings for PluresDB — backend-agnostic, TypeScript-first",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "import": "./dist/adapters/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "svelte",
    "svelte5",
    "reactive",
    "store",
    "runes",
    "pluresdb",
    "database",
    "p2p",
    "typescript"
  ],
  "author": "Oasis Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/plures/unum"
  },
  "peerDependencies": {
    "svelte": "^4.0.0 || ^5.0.0"
  },
  "devDependencies": {
    "jsdom": "^29.0.0",
    "svelte": "^5.0.0",
    "typescript": "^5.8.2",
    "vitest": "^1.0.0"
  }
}

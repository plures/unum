{
  "name": "@plures/unum",
  "version": "0.7.2",
  "description": "Reactive Svelte bindings for PluresDB — backend-agnostic, TypeScript-first",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "import": "./dist/adapters/index.js"
    },
    "./praxis": {
      "types": "./dist/praxis/index.d.ts",
      "import": "./dist/praxis/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE.md"
  ],
  "scripts": {
    "build": "tsc",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:prepublish": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "svelte",
    "svelte5",
    "reactive",
    "store",
    "runes",
    "pluresdb",
    "database",
    "p2p",
    "typescript"
  ],
  "author": "Oasis Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/plures/unum"
  },
  "peerDependencies": {
    "@plures/praxis": "^2.4.27",
    "hyperswarm": "^4.0.0",
    "svelte": "^4.0.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "@plures/praxis": {
      "optional": true
    },
    "hyperswarm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@plures/praxis": "^2.4.27",
    "@vitest/coverage-v8": "^4.1.1",
    "jsdom": "^29.0.0",
    "svelte": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.0.3",
    "vitest": "^4.1.1"
  },
  "engines": {
    "node": ">=24"
  }
}
